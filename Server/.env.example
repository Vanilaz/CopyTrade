# CopyTrade Relay Server v2.0 — Environment Variables
# Copy this file to .env and fill in your values

# Server ports
TCP_PORT=5555
HTTP_PORT=8080
# PORT=8080              # (Render/Vercel ใช้ตัวนี้แทน HTTP_PORT)

# Deployment mode
# HTTP_ONLY=true         # เปิดเฉพาะ HTTP (ไม่มี TCP) — สำหรับ Cloud deploy

# Security — REQUIRED for production
AUTH_TOKEN=your-secret-auth-token-here
DASHBOARD_PASSCODE=your-dashboard-passcode-here

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone for broker time calculations
BROKER_TIMEZONE=Europe/Athens
