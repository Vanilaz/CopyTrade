# CopyTrade Relay Server Environment Variables
# Copy this file to .env and fill in your values

# Server ports
TCP_PORT=5555
HTTP_PORT=8080

# Security — REQUIRED for production
AUTH_TOKEN=your-secret-auth-token-here
DASHBOARD_PASSCODE=your-dashboard-passcode-here

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone for broker time calculations
BROKER_TIMEZONE=Europe/Athens
